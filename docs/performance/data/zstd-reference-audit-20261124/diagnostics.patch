@@ -1636,0 +1640,89 @@ const Harness = struct {
+    // Locate the sequence modes byte from the RFC 8878 literals-header
+    // lengths and sequence-count encoding, without decoding any entropy.
+    fn auditSequenceModeOffset(payload: []const u8) ?usize {
+        if (payload.len == 0) return null;
+        const kind = payload[0] & 3;
+        const size_format = (payload[0] >> 2) & 3;
+        const width: u6 = switch (size_format) {
+            0, 1 => 10,
+            2 => 14,
+            else => 18,
+        };
+        const header_len: usize = if (kind < 2)
+            switch (size_format) {
+                0, 2 => 1,
+                1 => 2,
+                else => 3,
+            }
+        else
+            1 + (@as(usize, width) * 2 + 3) / 8;
+        if (payload.len < header_len) return null;
+        var bits: u64 = 0;
+        for (payload[0..header_len], 0..) |byte, i| bits |= @as(u64, byte) << @intCast(i * 8);
+        const literal_bytes: usize = switch (kind) {
+            0 => @intCast(bits >> @as(u6, if (header_len == 1) 3 else 4)),
+            1 => 1,
+            else => @intCast(bits >> (4 + width)),
+        };
+        const sequence_count_pos = header_len + literal_bytes;
+        if (sequence_count_pos >= payload.len) return null;
+        const first = payload[sequence_count_pos];
+        if (first == 0) return null;
+        const count_bytes: usize = if (first < 128) 1 else if (first < 255) 2 else 3;
+        const pos = sequence_count_pos + count_bytes;
+        if (pos >= payload.len or (first == 128 and payload[pos - 1] == 0)) return null;
+        return pos;
+    }
+
+    fn auditReservedModeEdit(original: []const u8, mutated: []const u8) bool {
+        if (original.len != mutated.len) return false;
+        var changed: ?usize = null;
+        for (original, mutated, 0..) |a, b, i| {
+            if (a == b) continue;
+            if (changed != null or a & 3 != 0 or (a ^ b) & 0xfc != 0) return false;
+            changed = i;
+        }
+        const position = changed orelse return false;
+        var iter = vort.zstd.iterateNativeFrameBlocks(original) catch return false;
+        while (iter.next() catch return false) |block| {
+            if (block.block_type != .compressed) continue;
+            const offset = auditSequenceModeOffset(original[block.payload_offset..][0..block.payload_len]) orelse continue;
+            if (position == block.payload_offset + offset) return true;
+        }
+        return false;
+    }
+
+    fn diagnoseZstdObservation(a: std.mem.Allocator, wire_case: WireCase, original: []const u8, operator: []const u8, reference_len: usize) !void {
+        if (wire_case.dictionary != null or wire_case.standard_dictionary_bytes != null or wire_case.zstd_magicless)
+            return error.UnexpectedZstdAuditOption;
+        const wire = wire_case.wire;
+        const decoded = vort.zstd.decodeFrameAlloc(a, wire) catch |err| {
+            var diag: vort.zstd.NativeStreamSummaryErrorDiagnostics = .{};
+            const layout: []const u8 = if (vort.zstd.summarizeNativeStreamWithDiagnostics(wire, &diag)) |_| "ok" else |layout_err| @errorName(layout_err);
+            if (!auditReservedModeEdit(original, wire) and original.len == wire.len) {
+                for (original, wire, 0..) |before, after, i| {
+                    if (before != after) std.debug.print("zstd-audit-local changed_offset={d} changed_bit_count={d} before_marker={?d} after_marker={?d}\n", .{
+                        i, @popCount(before ^ after),
+                        if (before == 0) @as(?u3, null) else std.math.log2_int(u8, before),
+                        if (after == 0) @as(?u3, null) else std.math.log2_int(u8, after),
+                    });
+                }
+                var iter = try vort.zstd.iterateNativeFrameBlocks(original);
+                while (try iter.next()) |block| {
+                    if (block.block_type != .compressed) continue;
+                    const mode_offset = auditSequenceModeOffset(original[block.payload_offset..][0..block.payload_len]);
+                    const status: []const u8 = if (vort.zstd.inspectNativeFrameBlockSequenceModes(wire, block)) |_| "ok" else |mode_err| @errorName(mode_err);
+                    std.debug.print("zstd-audit-local payload_start={d} payload_end={d} mode_relative={?d} modes_status={s}\n", .{ block.payload_offset, block.payload_offset + block.payload_len, mode_offset, status });
+                }
+            }
+            var hash: [32]u8 = undefined;
+            std.crypto.hash.sha2.Sha256.hash(wire, &hash, .{});
+            std.debug.print("zstd-audit wire={s} variant={s} op={s} source={d} compressed={d} reference={d} error={s} layout={s} phase={s} offset={d} reserved_only={}\n", .{
+                std.fmt.bytesToHex(hash, .lower), wire_case.label, operator, wire_case.source.len, wire.len, reference_len, @errorName(err), layout, @tagName(diag.phase), diag.offset, auditReservedModeEdit(original, wire),
+            });
+            return;
+        };
+        a.free(decoded);
+        return error.NonRepeatableZstdAudit;
+    }
+
