    "source": "const std = @import(\"std\");\nconst vort = @import(\"vort\");\nconst lib = @import(\"br_runtime\");\npub fn main(init: std.process.Init) !void {\n    var args = try std.process.Args.Iterator.initAllocator(init.minimal.args, init.gpa);\n    defer args.deinit();\n    _ = args.next();\n    const path = args.next().?;\n    const quality = try std.fmt.parseInt(c_int, args.next().?, 10);\n    const payload = try std.Io.Dir.cwd().readFileAlloc(init.io, path, init.gpa, .limited(16 * 1024 * 1024));\n    defer init.gpa.free(payload);\n    var runtime = try lib.Runtime.open();\n    defer runtime.deinit();\n    const encoded = try runtime.encodeAlloc(init.gpa, payload, quality);\n    defer init.gpa.free(encoded);\n    const out = try init.gpa.alloc(u8, payload.len);\n    defer init.gpa.free(out);\n    _ = try vort.brDecodeStreamInto(encoded, out);\n    if (!std.mem.eql(u8, payload, out)) return error.SizeMismatch;\n    var best: u64 = std.math.maxInt(u64);\n    var mix: usize = 0;\n    const iterations = 200;\n    for (0..5) |_| {\n        const start = std.Io.Clock.awake.now(init.io);\n        for (0..iterations) |_| mix +%= try vort.brDecodeStreamInto(encoded, out);\n        const ns: u64 = @intCast(start.durationTo(std.Io.Clock.awake.now(init.io)).nanoseconds);\n        best = @min(best, ns);\n    }\n    const header = try vort.br.benchmarkCompressedHeaders(init.io, init.gpa, encoded, iterations);\n    const profile = try vort.br.profileCompressedHeaders(init.io, init.gpa, encoded, 20);\n    var buffer: [2048]u8 = undefined;\n    var stdout = std.Io.File.stdout().writerStreaming(init.io, &buffer);\n    try stdout.interface.print(\"input={d} encoded={d} quality={d} iterations={d} full_ns={d} header_ns={d} header_share={d:.6} headers={d} header_bits={d} literal_trees={d} command_trees={d} distance_trees={d} checksum={d}\\n\", .{payload.len, encoded.len, quality, iterations, best, header.elapsed_ns, @as(f64, @floatFromInt(header.elapsed_ns))/@as(f64, @floatFromInt(best)), profile.compressed_meta_block_count/20, profile.input_bits/20, profile.literal_context_trees/20, profile.command_trees/20, profile.distance_context_trees/20, mix +% header.checksum});\n    try stdout.interface.flush();\n}\n",
