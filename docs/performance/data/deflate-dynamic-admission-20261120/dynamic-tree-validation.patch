diff --git a/src/deflate/dynamic/tests/deflate64.zig b/src/deflate/dynamic/tests/deflate64.zig
new file mode 100644
--- /dev/null
+++ b/src/deflate/dynamic/tests/deflate64.zig
@@ -0,0 +1,31 @@
+const std = @import("std");
+const deflate64 = @import("../../../deflate64.zig");
+const w = @import("wire.zig");
+const real = @import("real_samples.zig");
+const incremental = @import("incremental.zig");
+const t = std.testing;
+
+pub fn contracts() !void {
+    const invalid = [_][]const u8{&real.raw_bad};
+    for (invalid) |raw| {
+        var output: [4097]u8 = @splat(0xa5);
+        try t.expectError(error.InvalidHuffmanCode, deflate64.decodeInto(raw, &output));
+        try t.expectError(error.InvalidHuffmanCode, deflate64.decodeAlloc(t.allocator, raw));
+        for (output) |byte| try t.expectEqual(@as(u8, 0xa5), byte);
+        var history: [65536]u8 = @splat(0xa5);
+        var decoder = try deflate64.IncrementalDecoder.initWithHistory(.{}, &history);
+        try incremental.reject(&decoder, raw, true);
+        for (history) |byte| try t.expectEqual(@as(u8, 0xa5), byte);
+    }
+    inline for (.{ w.Kind.complete, w.Kind.empty_distance, w.Kind.singleton_literal, w.Kind.singleton_distance, w.Kind.deflate64_distance32 }) |kind| {
+        const raw = try w.make(kind);
+        defer t.allocator.free(raw);
+        const expected: []const u8 = if (kind == .singleton_literal) "" else "A";
+        const output = try deflate64.decodeAlloc(t.allocator, raw);
+        defer t.allocator.free(output);
+        try t.expectEqualSlices(u8, expected, output);
+        var history: [65536]u8 = @splat(0xa5);
+        var decoder = try deflate64.IncrementalDecoder.initWithHistory(.{}, &history);
+        try incremental.drain(&decoder, raw, expected);
+    }
+}
diff --git a/src/deflate/dynamic/tests/incremental.zig b/src/deflate/dynamic/tests/incremental.zig
new file mode 100644
--- /dev/null
+++ b/src/deflate/dynamic/tests/incremental.zig
@@ -0,0 +1,157 @@
+const std = @import("std");
+const w = @import("wire.zig");
+const real = @import("real_samples.zig");
+const t = std.testing;
+
+fn guard(bytes: []const u8) !void {
+    for (bytes) |byte| try t.expectEqual(@as(u8, 0xa5), byte);
+}
+
+pub fn reject(decoder: anytype, wire: []const u8, comptime fragmented: bool) !void {
+    var caller: [32768 + 32]u8 = @splat(0xa5);
+    const output = caller[16..][0..32768];
+    var consumed: usize = 0;
+    for (0..wire.len + 4) |_| {
+        const offered = wire[consumed..if (fragmented) @min(wire.len, consumed + 1) else wire.len];
+        const input_before = decoder.total_input;
+        const output_before = decoder.total_output;
+        if (decoder.step(offered, output)) |result| {
+            try t.expectEqual(@as(@TypeOf(input_before), @intCast(result.progress.input_read)), decoder.total_input - input_before);
+            try t.expectEqual(@as(@TypeOf(output_before), @intCast(result.progress.output_written)), decoder.total_output - output_before);
+            consumed += result.progress.input_read;
+            try t.expectEqual(@as(usize, 0), result.progress.output_written);
+            try t.expect(result.progress.input_read != 0);
+            try t.expect(result.status != .done);
+        } else |err| {
+            // Existing incremental shape errors retain their header-error
+            // category while all one-shot table errors use InvalidHuffmanCode.
+            try t.expectEqual(error.InvalidDynamicBlockHeader, err);
+            const advanced = decoder.total_input - input_before;
+            try t.expect(advanced <= offered.len);
+            consumed += @intCast(advanced);
+            try t.expectEqual(@as(@TypeOf(output_before), 0), decoder.total_output);
+            if (@hasField(@TypeOf(decoder.*), "last_step_progress")) {
+                try t.expectEqual(advanced, decoder.last_step_progress.input_read);
+                try t.expectEqual(@as(usize, 0), decoder.last_step_progress.output_written);
+            }
+            const error_input = decoder.total_input;
+            const diagnostics = decoder.diagnostics();
+            const phase = diagnostics.last_error_phase_name;
+            const name = diagnostics.last_error_name;
+            try t.expectError(error.InvalidDynamicBlockHeader, decoder.step(wire[consumed..], output));
+            try t.expectEqual(error_input, decoder.total_input);
+            try t.expectEqual(@as(@TypeOf(output_before), 0), decoder.total_output);
+            try t.expectEqualStrings(phase, decoder.diagnostics().last_error_phase_name);
+            try t.expectEqualStrings(name, decoder.diagnostics().last_error_name);
+            if (@hasField(@TypeOf(decoder.*), "last_step_progress")) {
+                try t.expectEqual(@as(usize, 0), decoder.last_step_progress.input_read);
+                try t.expectEqual(@as(usize, 0), decoder.last_step_progress.output_written);
+            }
+            try guard(&caller);
+            return;
+        }
+    }
+    return error.TestUnexpectedResult;
+}
+
+fn rawReject(comptime D: type, raw: []const u8) !void {
+    const Raw = D.RawDeflateIncrementalFixedLiteralDecoder;
+    inline for (.{ false, true }) |fragmented| {
+        var history: [32768]u8 = @splat(0xa5);
+        var decoder = try Raw.initWithHistory(.{}, &history);
+        try reject(&decoder, raw, fragmented);
+        try guard(&history);
+    }
+    // A long input and an attached caller workspace exercise admission before
+    // any semantic/rolling kernel can run or write to caller output/history.
+    const padded = try t.allocator.alloc(u8, raw.len + 8192);
+    defer t.allocator.free(padded);
+    @memcpy(padded[0..raw.len], raw);
+    @memset(padded[raw.len..], 0);
+    var history: [Raw.recommended_history_len]u8 = @splat(0xa5);
+    var decoder = try Raw.initWithHistory(.{ .allow_trailing_data = true }, &history);
+    var workspace: Raw.SemanticWorkspace = undefined;
+    try decoder.attachSemanticWorkspace(&workspace);
+    try reject(&decoder, padded, false);
+    try guard(&history);
+}
+
+fn wrappedReject(comptime D: type, comptime wrapper: w.Wrapper, wire: []const u8) !void {
+    inline for (.{ false, true }) |fragmented| {
+        var history: [32768]u8 = @splat(0xa5);
+        var decoder = if (wrapper == .zlib) try D.ZlibIncrementalDecoder.init(.{}, &history) else try D.GzipIncrementalDecoder.init(.{}, &history);
+        try reject(&decoder, wire, fragmented);
+        try guard(&history);
+    }
+}
+
+pub fn drain(decoder: anytype, wire: []const u8, expected: []const u8) !void {
+    var output: [32768]u8 = @splat(0xa5);
+    var consumed: usize = 0;
+    var produced: usize = 0;
+    for (0..512) |_| {
+        const limit = @min(wire.len, consumed + 1);
+        const before_input = decoder.total_input;
+        const before_output = decoder.total_output;
+        const result = try decoder.step(wire[consumed..limit], output[produced..]);
+        consumed += result.progress.input_read;
+        produced += result.progress.output_written;
+        try t.expectEqual(@as(@TypeOf(before_input), @intCast(result.progress.input_read)), decoder.total_input - before_input);
+        try t.expectEqual(@as(@TypeOf(before_output), @intCast(result.progress.output_written)), decoder.total_output - before_output);
+        if (result.status == .done) {
+            try t.expectEqual(wire.len, consumed);
+            try t.expectEqual(expected.len, produced);
+            try t.expectEqualSlices(u8, expected, output[0..produced]);
+            try guard(output[produced..]);
+            return;
+        }
+        try t.expect(result.progress.input_read != 0 or result.progress.output_written != 0);
+    }
+    return error.TestUnexpectedResult;
+}
+
+fn controls(comptime D: type) !void {
+    inline for (.{ w.Kind.complete, w.Kind.empty_distance, w.Kind.singleton_distance, w.Kind.singleton_literal }) |kind| {
+        const raw = try w.make(kind);
+        defer t.allocator.free(raw);
+        const expected: []const u8 = if (kind == .singleton_literal) "" else "A";
+        var history: [32768]u8 = @splat(0xa5);
+        var decoder = try D.RawDeflateIncrementalFixedLiteralDecoder.initWithHistory(.{}, &history);
+        try drain(&decoder, raw, expected);
+        inline for (.{ w.Wrapper.zlib, w.Wrapper.gzip }) |wrapper| {
+            const frame = try w.wrap(wrapper, raw, expected, "");
+            defer t.allocator.free(frame);
+            var wrapped = if (wrapper == .zlib) try D.ZlibIncrementalDecoder.init(.{}, &history) else try D.GzipIncrementalDecoder.init(.{}, &history);
+            try drain(&wrapped, frame, expected);
+        }
+    }
+    const raw = try w.make(.dictionary_match);
+    defer t.allocator.free(raw);
+    var history: [32768]u8 = @splat(0xa5);
+    var decoder = try D.RawDeflateIncrementalFixedLiteralDecoder.initWithDictionary(.{}, &history, "A");
+    try drain(&decoder, raw, "AAA");
+    const zlib = try w.wrap(.zlib, raw, "AAA", "A");
+    defer t.allocator.free(zlib);
+    var wrapped = try D.ZlibIncrementalDecoder.initWithDictionary(.{}, &history, "A");
+    try drain(&wrapped, zlib, "AAA");
+}
+
+pub fn contracts(comptime D: type) !void {
+    try rawReject(D, &real.raw_bad);
+    try wrappedReject(D, .gzip, &real.gzip_bad);
+    inline for (.{
+        w.Kind.incomplete_codes,       w.Kind.incomplete_literal,      w.Kind.long_literal_singleton,
+        w.Kind.incomplete_distance,    w.Kind.long_distance_singleton, w.Kind.oversubscribed_codes,
+        w.Kind.oversubscribed_literal, w.Kind.oversubscribed_distance, w.Kind.missing_eob,
+    }) |kind| {
+        const raw = try w.make(kind);
+        defer t.allocator.free(raw);
+        try rawReject(D, raw);
+        inline for (.{ w.Wrapper.zlib, w.Wrapper.gzip }) |wrapper| {
+            const frame = try w.wrap(wrapper, raw, "A", "");
+            defer t.allocator.free(frame);
+            try wrappedReject(D, wrapper, frame);
+        }
+    }
+    try controls(D);
+}
diff --git a/src/deflate/dynamic/tests/one_shot.zig b/src/deflate/dynamic/tests/one_shot.zig
new file mode 100644
--- /dev/null
+++ b/src/deflate/dynamic/tests/one_shot.zig
@@ -0,0 +1,138 @@
+const std = @import("std");
+const w = @import("wire.zig");
+const real = @import("real_samples.zig");
+const t = std.testing;
+
+fn guard(bytes: []const u8) !void {
+    for (bytes) |byte| try t.expectEqual(@as(u8, 0xa5), byte);
+}
+
+pub fn rejectRaw(comptime D: type, raw: []const u8, expected: anyerror) !void {
+    var caller: [4097 + 32]u8 = @splat(0xa5);
+    const output = caller[16..][0..4097];
+    try t.expectError(expected, D.decodeRawAuto(raw, output));
+    try guard(&caller);
+    try t.expectError(expected, D.decodeRawAutoWithDictionary(raw, "A", output));
+    try guard(&caller);
+    try t.expectError(expected, D.decodeRawDynamicAllocStrict(t.allocator, raw));
+    try t.expectError(expected, D.decodeRawAutoAlloc(t.allocator, raw));
+    try t.expectError(expected, D.parseRawDeflateHeaderInfo(raw));
+    try t.expectError(expected, D.profileFirstDynamicDeflateBlock(raw));
+    var joined: [1024]u8 = @splat(0x5a);
+    const chunks = [_][]const u8{ raw[0..1], raw[1 .. raw.len / 2], raw[raw.len / 2 ..] };
+    try t.expectError(expected, D.decodeRawChunks(&chunks, &joined, output));
+    try guard(&caller);
+    try t.expectError(expected, D.RawDeflateDecoder.init(raw, output));
+    try guard(&caller);
+
+    const dictionary_frame = try w.wrap(.zlib, raw, "A", "A");
+    defer t.allocator.free(dictionary_frame);
+    const dictionary_chunks = [_][]const u8{ dictionary_frame[0..6], dictionary_frame[6..] };
+    try t.expectError(expected, D.decodeZlibWithDictionary(dictionary_frame, output, "A"));
+    try t.expectError(expected, D.decodeZlibChunksIntoWithDictionary(&dictionary_chunks, output, "A"));
+    try guard(&caller);
+
+    var appended: std.ArrayList(u8) = .empty;
+    defer appended.deinit(t.allocator);
+    try appended.appendSlice(t.allocator, "committed-prefix");
+    try t.expectError(expected, D.decodeRawAutoAppend(t.allocator, &appended, raw));
+    try t.expectEqualSlices(u8, "committed-prefix", appended.items);
+    inline for (.{ w.Wrapper.zlib, w.Wrapper.gzip }) |wrapper| {
+        const frame = try w.wrap(wrapper, raw, "A", "");
+        defer t.allocator.free(frame);
+        const split = [_][]const u8{ frame[0..2], frame[2..11], frame[11..] };
+        if (wrapper == .zlib) {
+            try t.expectError(expected, D.decodeZlib(frame, output));
+            try t.expectError(expected, D.decodeZlibChunksInto(&split, output));
+            try t.expectError(expected, D.ZlibDecoder.initFromChunksDirect(&split, output));
+        } else {
+            try t.expectError(expected, D.decodeGzip(frame, output));
+            try t.expectError(expected, D.decodeGzipChunksInto(&split, output));
+            try t.expectError(expected, D.GzipDecoder.initFromChunksDirect(&split, output));
+        }
+        try guard(&caller);
+    }
+}
+
+fn controls(comptime D: type) !void {
+    inline for (.{ w.Kind.complete, w.Kind.empty_distance, w.Kind.singleton_distance, w.Kind.singleton_literal }) |kind| {
+        const raw = try w.make(kind);
+        defer t.allocator.free(raw);
+        const expected: []const u8 = if (kind == .singleton_literal) "" else "A";
+        var output: [8]u8 = @splat(0xa5);
+        const decoded = try D.decodeRawAuto(raw, &output);
+        try t.expectEqual(expected.len, decoded.output_written);
+        try t.expectEqualSlices(u8, expected, output[0..decoded.output_written]);
+        const allocated = try D.decodeRawAutoAlloc(t.allocator, raw);
+        defer t.allocator.free(allocated);
+        try t.expectEqualSlices(u8, expected, allocated);
+        inline for (.{ w.Wrapper.zlib, w.Wrapper.gzip }) |wrapper| {
+            const frame = try w.wrap(wrapper, raw, expected, "");
+            defer t.allocator.free(frame);
+            const split = [_][]const u8{ frame[0..1], frame[1..13], frame[13..] };
+            const count = if (wrapper == .zlib) try D.decodeZlibChunksInto(&split, &output) else try D.decodeGzipChunksInto(&split, &output);
+            try t.expectEqual(expected.len, count);
+            try t.expectEqualSlices(u8, expected, output[0..count]);
+        }
+    }
+    const dictionary_raw = try w.make(.dictionary_match);
+    defer t.allocator.free(dictionary_raw);
+    var output: [3]u8 = undefined;
+    const decoded = try D.decodeRawAutoWithDictionary(dictionary_raw, "A", &output);
+    try t.expectEqual(@as(usize, 3), decoded.output_written);
+    try t.expectEqualSlices(u8, "AAA", &output);
+
+    // Empty DIST is admitted for literals, but actual distance use retains
+    // its InvalidHuffmanCode symbol error rather than a shape/header error.
+    const no_distance = try w.make(.empty_distance_match);
+    defer t.allocator.free(no_distance);
+    var protected: [8]u8 = @splat(0xa5);
+    try t.expectError(error.InvalidHuffmanCode, D.decodeRawAutoWithDictionary(no_distance, "A", &protected));
+    try guard(&protected);
+    const zlib = try w.wrap(.zlib, dictionary_raw, "AAA", "A");
+    defer t.allocator.free(zlib);
+    const chunks = [_][]const u8{ zlib[0..4], zlib[4..] };
+    try t.expectEqual(@as(usize, 3), try D.decodeZlibChunksIntoWithDictionary(&chunks, &output, "A"));
+    try t.expectEqualSlices(u8, "AAA", &output);
+
+    const raw = try w.make(.complete);
+    defer t.allocator.free(raw);
+    try t.expectError(error.OutputTooSmall, D.decodeRawAuto(raw, &.{}));
+    try t.expectError(error.OutputLimitExceeded, D.decodeRawAutoAllocLimited(t.allocator, raw, 0));
+    try t.expectError(error.OutOfMemory, D.decodeRawAutoAlloc(t.failing_allocator, raw));
+    try t.expectError(error.SizeMismatch, D.decodeRawAutoAllocExactSize(t.allocator, raw, 2));
+}
+
+fn realCases(comptime D: type) !void {
+    try rejectRaw(D, &real.raw_bad, error.InvalidHuffmanCode);
+    var caller: [82021 + 32]u8 = @splat(0xa5);
+    const output = caller[16..][0..82021];
+    try t.expectError(error.InvalidHuffmanCode, D.decodeGzip(&real.gzip_bad, output));
+    const chunks = [_][]const u8{ real.gzip_bad[0..1], real.gzip_bad[1..29], real.gzip_bad[29..] };
+    try t.expectError(error.InvalidHuffmanCode, D.decodeGzipChunksInto(&chunks, output));
+    try t.expectError(error.InvalidHuffmanCode, D.GzipDecoder.initFromChunksDirect(&chunks, output));
+    try guard(&caller);
+    const raw = try D.decodeRawAutoAlloc(t.allocator, &real.raw_original);
+    defer t.allocator.free(raw);
+    try t.expectEqualSlices(u8, &real.raw_plain, raw);
+    const gzip = try D.decodeGzipAlloc(t.allocator, &real.gzip_original);
+    defer t.allocator.free(gzip);
+    try t.expectEqualSlices(u8, &real.gzip_plain, gzip);
+}
+
+pub fn contracts(comptime D: type) !void {
+    try realCases(D);
+    inline for (.{
+        w.Kind.incomplete_codes,       w.Kind.incomplete_literal,      w.Kind.long_literal_singleton,
+        w.Kind.incomplete_distance,    w.Kind.long_distance_singleton, w.Kind.oversubscribed_codes,
+        w.Kind.oversubscribed_literal, w.Kind.oversubscribed_distance,
+    }) |kind| {
+        const raw = try w.make(kind);
+        defer t.allocator.free(raw);
+        try rejectRaw(D, raw, error.InvalidHuffmanCode);
+    }
+    const no_eob = try w.make(.missing_eob);
+    defer t.allocator.free(no_eob);
+    try rejectRaw(D, no_eob, error.InvalidDynamicBlockHeader);
+    try controls(D);
+}
