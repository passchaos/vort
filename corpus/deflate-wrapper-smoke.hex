# Raw deflate samples: valid fixed "a", then non-final fixed/truncated.
--deflate
4b0400 # expect: accept
090000ffff # expect: accept
4a0400 # expect: reject
4b043e00 # expect: reject

# zlib-wrapped fixed "hello", stored empty with non-zero stored padding, then bad header/preset dictionaries.
--zlib
7801cb48cdc9c90700062c0215 # expect: accept
7801090000ffff00000001 # expect: accept
0000 # expect: reject
782000000000 # expect: reject
78f908610235cb4027013a2e067d # expect: reject
78014b043e0000000000 # expect: reject

# gzip-wrapped fixed "hello", then bad header.
--gzip
1f8b0800000000000403cb48cdc9c9070086a6103605000000 # expect: accept
1f8b0800000000000403090000ffff0000000000000000 # expect: accept
0000 # expect: reject
1f8b08000000000004034b043e000000000000000000 # expect: reject

# Malformed dynamic Huffman: oversubscribed code-length alphabet.
--deflate
05009200 # expect: reject
--zlib
78010500920000000000 # expect: reject
--gzip
1f8b0800000000000403050092000000000000000000 # expect: reject

# Malformed dynamic Huffman: code-length repeat 16 without previous length.
--deflate
05000224 # expect: reject
--zlib
78010500022400000000 # expect: reject
--gzip
1f8b0800000000000403050002240000000000000000 # expect: reject

# Malformed dynamic Huffman: literal/length alphabet omits end-of-block.
--deflate
05c001040000000010000000000000000000000000010000000000000000000000000000000000000000 # expect: reject
--zlib
780105c00104000000001000000000000000000000000001000000000000000000000000000000000000000000000000 # expect: reject
--gzip
1f8b080000000000040305c0010400000000100000000000000000000000000100000000000000000000000000000000000000000000000000000000 # expect: reject
