+/* Read a mapped inline payload from its inode metadata address space. */
+static int vort_erofs_read_metabox_data(struct erofs_inode *inode,
+                                      void *output, u64 offset, size_t len)
+{
+    struct erofs_buf buf = __EROFS_BUF_INITIALIZER;
+    const size_t block_size = erofs_blksiz(inode->sbi);
+    char *dst = output;
+
+    while (len) {
+        void *src = erofs_read_metabuf(&buf, inode->sbi, offset, true);
+        size_t size = min_t(size_t, len, block_size - erofs_blkoff(inode->sbi, offset));
+        if (IS_ERR(src))
+            return PTR_ERR(src);
+        memcpy(dst, src, size);
+        dst += size;
+        offset += size;
+        len -= size;
+    }
+    erofs_put_metabuf(&buf);
+    return 0;
+}
